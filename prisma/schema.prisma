generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ImportRun {
  id                 String   @id
  source             String
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  storyCount         Int      @default(0)
  characterCount     Int      @default(0)
  storyCharacterCount Int     @default(0)
  manifestJson       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Story {
  id                     String           @id
  source                 String
  sourceUrl              String?
  title                  String
  slug                   String?
  status                 String?
  visibility             String?
  creatorId              String?
  creatorUsername        String?
  category               String?
  contentRating          String?
  nsfw                   Boolean          @default(false)
  plotSummary            String?
  plot                   String?
  firstMessagesJson      Json?
  codexJson              Json?
  tagsJson               Json?
  coverJson              Json?
  videoCoverJson         Json?
  characterSnapshotsJson Json?
  defaultChatSettingsJson Json?
  dmConfigJson           Json?
  engagementJson         Json?
  languageCode           String?
  availableLanguageCodesJson Json?
  visualNovelReady       Boolean          @default(false)
  dmV2Ready              Boolean          @default(false)
  publishedAt            DateTime?
  sourceCreatedAt        DateTime?
  sourceUpdatedAt        DateTime?
  importedAt             DateTime         @default(now())
  rawJson                Json
  storyCharacters        StoryCharacter[]

  @@index([source])
  @@index([publishedAt])
  @@index([creatorUsername])
  @@index([category])
}

model Character {
  id                         String           @id
  source                     String
  sourceUrl                  String?
  name                       String
  status                     String?
  visibility                 String?
  creatorId                  String?
  creatorUsername            String?
  descriptionSummary         String?
  description                String?
  exampleDialogue            String?
  sheetsJson                 Json?
  tagsJson                   Json?
  coverJson                  Json?
  mediaJson                  Json?
  mediaSnapshotsJson         Json?
  contentRating              String?
  nsfw                       Boolean          @default(false)
  languageCode               String?
  availableLanguageCodesJson Json?
  sourceCreatedAt            DateTime?
  sourceUpdatedAt            DateTime?
  importedAt                 DateTime         @default(now())
  rawJson                    Json
  storyCharacters            StoryCharacter[]

  @@index([source])
  @@index([creatorUsername])
  @@index([name])
}

model StoryCharacter {
  id             String    @id
  storyId        String
  characterId    String
  storyTitle     String?
  name           String?
  snapshotJson   Json?
  importedAt     DateTime  @default(now())
  story          Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@index([characterId])
}
