<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta httpEquiv="X-UA-Compatible" content="IE=edge"/>

    <!-- Early connections for first data/image fetches -->
    <link rel="preconnect" href="https://api.isekaizero.ai" crossorigin/>
    <link rel="preconnect" href="https://s3.alterworld.ai"/>

    <!-- Marketing pixels (GTM, Meta, X, TikTok).
         Stubs are installed immediately so early events queue; loading of the
         real vendor scripts is owned by /cookie-consent.js (PECR/ePrivacy):
         UK/EEA/CH visitors must consent first, everyone else keeps the old
         deferred loading (first interaction or load + 2.5s). -->
    <script>
    (function () {
      /* GTM stub */
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

      /* Meta Pixel stub */
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[]}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '862536653014706');
      fbq('track', 'PageView');

      /* X pixel stub */
      !function(e,t,n,s,u,a){e.twq||(s=e.twq=function(){s.exe?s.exe.apply(s,arguments):s.queue.push(arguments);
      },s.version='1.1',s.queue=[])}(window,document,'script');
      twq('config','qwh6w');

      /* TikTok pixel stub (mirrors ttq.load minus the script injection) */
      !function (w, d, t) {
        w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(
      var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};
        var id='D5HM693C77U4TPM9G1OG';
        ttq._i=ttq._i||{};ttq._i[id]=[];ttq._i[id]._u='https://analytics.tiktok.com/i18n/pixel/events.js';
        ttq._t=ttq._t||{};ttq._t[id]=+new Date;ttq._o=ttq._o||{};ttq._o[id]={};
        ttq.page();
      }(window, document, 'ttq');

      /* Queueing stub of the consent API so the app bundle can never race
         the deferred cookie-consent.js: callbacks registered here are
         drained by the real script once it decides. Until then nothing is
         allowed to fire. */
      window.__izConsent = {
        _q: [],
        _stub: true,
        status: function () { return 'pending'; },
        isAllowed: function () { return false; },
        onAllowed: function (cb) { this._q.push(cb); },
        open: function () {},
      };
    })();
    </script>
    <script src="/cookie-consent.js" defer></script>

    <!-- Google AdSense (disabled)
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7923872779172393"
         crossorigin="anonymous"></script>
    End Google AdSense -->

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, interactive-widget=resizes-content"/>
    <title>ISEKAI ZERO - AI Roleplay & AI Story | Live Your Adventure</title>

    <!-- The `react-native-web` recommended style reset: https://necolas.github.io/react-native-web/docs/setup/#root-element -->
    <style id="expo-reset">
        /* These styles make the body full-height */
        html,
        body {
            height: 100%;
            background-color: #090027;
        }

        /* These styles disable body scrolling if you are using <ScrollView> */
        body {
            overflow: hidden;
        }

        /* These styles make the root element full-height */
        #root {
            display: flex;
            height: 100%;
            flex: 1;
        }

        /* Boot splash — shown instantly, removed when the app mounts into #root */
        #boot-splash {
            position: fixed;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 28px;
            overflow: hidden;
            /* brand night-sky art (same as /download/qr) under a soft vignette;
               solid color paints instantly while the jpg streams in */
            background:
                radial-gradient(120% 90% at 50% 35%, rgba(12,3,51,.20) 0%, rgba(9,0,39,.62) 100%),
                url(/splash-bg.jpg) center / cover no-repeat,
                radial-gradient(120% 90% at 50% 30%, #180a4a 0%, #0c0333 45%, #090027 100%);
        }

        /* Twinkling starfield (two layers on pseudo-elements, opposite phases) */
        #boot-splash::before,
        #boot-splash::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-image:
                radial-gradient(1.5px 1.5px at 12% 22%, rgba(255,255,255,.9), transparent 50%),
                radial-gradient(1px 1px at 28% 64%, rgba(255,255,255,.7), transparent 50%),
                radial-gradient(1.5px 1.5px at 43% 12%, rgba(255,255,255,.8), transparent 50%),
                radial-gradient(1px 1px at 61% 41%, rgba(255,255,255,.6), transparent 50%),
                radial-gradient(1.5px 1.5px at 76% 18%, rgba(255,255,255,.9), transparent 50%),
                radial-gradient(1px 1px at 88% 56%, rgba(255,255,255,.7), transparent 50%),
                radial-gradient(1px 1px at 7% 81%, rgba(255,255,255,.6), transparent 50%),
                radial-gradient(1.5px 1.5px at 52% 88%, rgba(255,255,255,.8), transparent 50%),
                radial-gradient(1px 1px at 93% 84%, rgba(255,255,255,.6), transparent 50%);
            animation: boot-twinkle 3.2s ease-in-out infinite alternate;
        }
        #boot-splash::after {
            background-image:
                radial-gradient(1px 1px at 18% 45%, rgba(190,180,255,.8), transparent 50%),
                radial-gradient(1.5px 1.5px at 34% 30%, rgba(255,255,255,.7), transparent 50%),
                radial-gradient(1px 1px at 49% 57%, rgba(190,180,255,.6), transparent 50%),
                radial-gradient(1.5px 1.5px at 68% 74%, rgba(255,255,255,.8), transparent 50%),
                radial-gradient(1px 1px at 82% 34%, rgba(190,180,255,.7), transparent 50%),
                radial-gradient(1.5px 1.5px at 23% 90%, rgba(255,255,255,.6), transparent 50%),
                radial-gradient(1px 1px at 95% 10%, rgba(255,255,255,.7), transparent 50%);
            animation-delay: -1.6s;
        }
        @keyframes boot-twinkle {
            from { opacity: .3; }
            to   { opacity: 1; }
        }

        /* Summoning scene: glyph floating over a tilted magic circle + light beam */
        .boot-orb {
            position: relative;
            width: 270px;
            height: 165px;
            perspective: 700px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        /* pulsing portal aura behind the glyph */
        .boot-aura {
            position: absolute;
            left: 50%;
            top: 52%;
            width: 190px;
            height: 190px;
            margin: -95px 0 0 -95px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(120,90,255,.32) 0%, rgba(120,90,255,.12) 45%, transparent 72%);
            animation: boot-aura 3s ease-in-out infinite;
        }
        @keyframes boot-aura {
            0%, 100% { transform: scale(.92); opacity: .7; }
            50%      { transform: scale(1.07); opacity: 1; }
        }
        /* the magic circle lying on the "ground" (perspective-tilted, spinning) */
        .boot-ground {
            position: absolute;
            left: 50%;
            bottom: -88px;
            width: 240px;
            height: 240px;
            margin-left: -120px;
            transform: rotateX(74deg);
            animation: boot-ground-spin 12s linear infinite;
            pointer-events: none;
        }
        @keyframes boot-ground-spin {
            from { transform: rotateX(74deg) rotate(0deg); }
            to   { transform: rotateX(74deg) rotate(360deg); }
        }
        .boot-ground::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: conic-gradient(from 0deg, transparent 0 55%, rgba(255,178,92,.95) 100%);
            -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
            mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
            filter: drop-shadow(0 0 8px rgba(255,150,60,.6));
        }
        .boot-ground::after {
            content: "";
            position: absolute;
            inset: 20px;
            border-radius: 50%;
            border: 1px dashed rgba(160,140,255,.55);
            box-shadow: 0 0 12px rgba(140,120,255,.35), inset 0 0 22px rgba(140,120,255,.28);
        }
        /* rune glyphs laid into the ground circle */
        .boot-runes {
            position: absolute;
            inset: 0;
        }
        .boot-runes span {
            position: absolute;
            left: 50%;
            top: 50%;
            font: 16px/1 system-ui, sans-serif;
            color: rgba(170,150,255,.95);
            text-shadow: 0 0 8px rgba(140,120,255,.95);
            animation: boot-twinkle 2.4s ease-in-out infinite alternate;
        }
        .boot-runes span:nth-child(1)  { transform: translate(-50%,-50%) rotate(0deg)   translateY(-104px); }
        .boot-runes span:nth-child(2)  { transform: translate(-50%,-50%) rotate(30deg)  translateY(-104px); animation-delay: -.2s; }
        .boot-runes span:nth-child(3)  { transform: translate(-50%,-50%) rotate(60deg)  translateY(-104px); animation-delay: -.4s; }
        .boot-runes span:nth-child(4)  { transform: translate(-50%,-50%) rotate(90deg)  translateY(-104px); animation-delay: -.6s; }
        .boot-runes span:nth-child(5)  { transform: translate(-50%,-50%) rotate(120deg) translateY(-104px); animation-delay: -.8s; }
        .boot-runes span:nth-child(6)  { transform: translate(-50%,-50%) rotate(150deg) translateY(-104px); animation-delay: -1s; }
        .boot-runes span:nth-child(7)  { transform: translate(-50%,-50%) rotate(180deg) translateY(-104px); animation-delay: -1.2s; }
        .boot-runes span:nth-child(8)  { transform: translate(-50%,-50%) rotate(210deg) translateY(-104px); animation-delay: -1.4s; }
        .boot-runes span:nth-child(9)  { transform: translate(-50%,-50%) rotate(240deg) translateY(-104px); animation-delay: -1.6s; }
        .boot-runes span:nth-child(10) { transform: translate(-50%,-50%) rotate(270deg) translateY(-104px); animation-delay: -1.8s; }
        .boot-runes span:nth-child(11) { transform: translate(-50%,-50%) rotate(300deg) translateY(-104px); animation-delay: -2s; }
        .boot-runes span:nth-child(12) { transform: translate(-50%,-50%) rotate(330deg) translateY(-104px); animation-delay: -2.2s; }
        /* the floating flame-book glyph, hovering at the center of the circle */
        .boot-icon {
            position: absolute;
            left: 50%;
            bottom: 15px;
            width: 150px;
            height: 131px;
            margin-left: -75px;
            animation: boot-float 3s ease-in-out infinite;
        }
        @keyframes boot-float {
            0%, 100% { transform: translateY(5px);  filter: drop-shadow(0 6px 14px rgba(0,0,0,.5))  drop-shadow(0 0 14px rgba(255,150,60,.35)); }
            50%      { transform: translateY(-7px); filter: drop-shadow(0 10px 18px rgba(0,0,0,.45)) drop-shadow(0 0 26px rgba(255,170,80,.65)); }
        }
        /* anime sparkle glints around the glyph */
        .boot-spark {
            position: absolute;
            font-size: 15px;
            color: #fff;
            text-shadow: 0 0 9px rgba(255,255,255,.95);
            opacity: 0;
            animation: boot-spark 2.8s ease-in-out infinite;
            pointer-events: none;
        }
        .boot-spark:nth-of-type(1) { top: 16%; left: 24%; animation-delay: .4s; }
        .boot-spark:nth-of-type(2) { top: 30%; right: 18%; animation-delay: 1.5s; font-size: 11px; color: #ffd9a0; text-shadow: 0 0 8px rgba(255,200,130,.95); }
        .boot-spark:nth-of-type(3) { top: 4%;  left: 56%; animation-delay: 2.2s; font-size: 12px; }
        @keyframes boot-spark {
            0%, 100% { opacity: 0; transform: scale(.3) rotate(0deg); }
            50%      { opacity: 1; transform: scale(1) rotate(90deg); }
        }

        /* Embers rising out of the orb */
        .boot-ember {
            position: absolute;
            bottom: 18%;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: radial-gradient(circle, #ffd9a0 0%, #ff8a3c 70%, transparent 100%);
            opacity: 0;
            animation: boot-ember 2.4s ease-out infinite;
            pointer-events: none;
        }
        .boot-ember:nth-child(1) { left: 22%; animation-delay: 0s;    width: 4px; height: 4px; }
        .boot-ember:nth-child(2) { left: 38%; animation-delay: .5s; }
        .boot-ember:nth-child(3) { left: 52%; animation-delay: 1.1s;  width: 6px; height: 6px; }
        .boot-ember:nth-child(4) { left: 66%; animation-delay: .8s;   width: 3px; height: 3px; }
        .boot-ember:nth-child(5) { left: 78%; animation-delay: 1.6s; }
        .boot-ember:nth-child(6) { left: 30%; animation-delay: 1.9s;  width: 3px; height: 3px; }
        .boot-ember:nth-child(7) { left: 60%; animation-delay: 2.1s;  width: 4px; height: 4px; }
        @keyframes boot-ember {
            0%   { transform: translateY(0) scale(1);        opacity: 0; }
            15%  { opacity: .9; }
            100% { transform: translateY(-110px) scale(.4);  opacity: 0; }
        }

        /* Brand logotype */
        .boot-logotype {
            width: min(330px, 76vw);
            height: auto;
            animation: boot-logo-glow 3.2s ease-in-out infinite;
        }
        @keyframes boot-logo-glow {
            0%, 100% { filter: drop-shadow(0 3px 10px rgba(0,0,0,.7)) drop-shadow(0 0 14px rgba(150,120,255,.25)); }
            50%      { filter: drop-shadow(0 3px 10px rgba(0,0,0,.7)) drop-shadow(0 0 26px rgba(170,140,255,.55)); }
        }

        /* Occasional shooting stars */
        .boot-meteor {
            position: absolute;
            top: 15%;
            left: 74%;
            width: 130px;
            height: 2px;
            border-radius: 2px;
            background: linear-gradient(90deg, rgba(255,255,255,.95), rgba(255,255,255,0));
            opacity: 0;
            animation: boot-meteor 9s linear infinite 2s;
            pointer-events: none;
        }
        .boot-meteor + .boot-meteor {
            top: 34%;
            left: 10%;
            width: 95px;
            animation-delay: 6.5s;
        }
        @keyframes boot-meteor {
            0%, 82% { opacity: 0; transform: rotate(-32deg) translateX(0); }
            85%     { opacity: .95; }
            100%    { opacity: 0; transform: rotate(-32deg) translateX(-270px); }
        }

        /* Indeterminate sweep bar */
        .boot-bar {
            position: relative;
            width: 180px;
            height: 3px;
            border-radius: 2px;
            background: rgba(255,255,255,.14);
            box-shadow: 0 1px 4px rgba(0,0,0,.4);
            overflow: hidden;
        }
        .boot-bar i {
            position: absolute;
            display: block;
            height: 100%;
            width: 40%;
            border-radius: 2px;
            background: linear-gradient(90deg, transparent, #ff9a4d, #ffd9a0);
            animation: boot-sweep 1.4s ease-in-out infinite;
        }
        @keyframes boot-sweep {
            0%   { left: -40%; }
            100% { left: 100%; }
        }

        /* Cycling flavor text */
        .boot-tag {
            position: relative;
            width: 100%;
            height: 16px;
            margin-top: -8px;
        }
        .boot-tag span {
            position: absolute;
            inset: 0;
            text-align: center;
            font: 400 12px/16px system-ui, -apple-system, "Segoe UI", sans-serif;
            letter-spacing: .08em;
            color: rgba(232,228,255,.92);
            text-shadow: 0 1px 6px rgba(0,0,0,.85), 0 0 14px rgba(9,0,39,.9);
            white-space: nowrap;
            opacity: 0;
            animation: boot-phrase 7.5s ease-in-out infinite;
        }
        .boot-tag span:nth-child(2) { animation-delay: 2.5s; }
        .boot-tag span:nth-child(3) { animation-delay: 5s; }
        @keyframes boot-phrase {
            0%   { opacity: 0; transform: translateY(6px); }
            5%   { opacity: 1; transform: translateY(0); }
            29%  { opacity: 1; }
            34%  { opacity: 0; transform: translateY(-6px); }
            100% { opacity: 0; }
        }

        /* App download promo below the loader UI */
        .boot-stores {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            margin-top: 14px;
        }
        .boot-stores-label {
            font: 400 11px/1 system-ui, -apple-system, "Segoe UI", sans-serif;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: rgba(224,218,255,.85);
            text-shadow: 0 1px 6px rgba(0,0,0,.85);
        }
        .boot-stores-badges {
            display: flex;
            gap: 10px;
        }
        .boot-store {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 7px 14px 7px 12px;
            border: 1px solid rgba(255,255,255,.28);
            border-radius: 11px;
            background: rgba(9,0,39,.62);
            text-decoration: none;
        }
        .boot-store svg {
            width: 20px;
            height: 20px;
            fill: #fff;
        }
        .boot-store i {
            display: block;
            font: 400 8.5px/1 system-ui, -apple-system, "Segoe UI", sans-serif;
            font-style: normal;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: rgba(255,255,255,.75);
            margin-bottom: 2px;
        }
        .boot-store b {
            display: block;
            font: 700 13px/1.1 system-ui, -apple-system, "Segoe UI", sans-serif;
            letter-spacing: .02em;
            color: #fff;
        }

        @media (prefers-reduced-motion: reduce) {
            #boot-splash *,
            #boot-splash::before,
            #boot-splash::after { animation: none !important; }
            .boot-tag span { opacity: 0; }
            .boot-tag span:first-child { opacity: 1; }
            .boot-ember,
            .boot-spark,
            .boot-meteor { opacity: 0; }
        }

        /* Always show horizontal scrollbars */
        *::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }
        *::-webkit-scrollbar-track {
            background: #222;
        }
        *::-webkit-scrollbar-thumb {
            background: #555;
            border-radius: 4px;
        }
        *::-webkit-scrollbar-thumb:hover {
            background: #777;
        }
    </style>

