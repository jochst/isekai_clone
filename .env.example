DATABASE_URL="file:./dev.db"

# Provider keys stay on the server and never reach the browser.
# Easiest: enter them in Settings → Providers (saved encrypted in data/keys.sqlite, editable from any device).
# Keys here are the fallback when nothing is saved in Settings. Copy to .env.local, then restart `npm run dev`.
NANOGPT_API_KEY=""
ELEVENLABS_API_KEY=""
# OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""
# CUSTOM_API_KEY=""

# Secret that encrypts keys saved in Settings. Optional: without it one is generated in data/keys.secret.
# Keep it (or that file) safe; if it changes, saved keys must be entered again.
# KEYS_SECRET=""

# Remote access through a Cloudflare Tunnel + Cloudflare Access (docs/DEPLOY.md). Leave empty to stay localhost-only.
# PUBLIC_HOSTS="iz.juicebox.cc"
# CF_ACCESS_TEAM_DOMAIN="yourteam.cloudflareaccess.com"
# CF_ACCESS_AUD=""
