DATABASE_URL="file:./dev.db"

# Provider keys stay on the server and never reach the browser.
# Copy to .env.local and fill in the ones you use, then restart `npm run dev`.
NANOGPT_API_KEY=""
ELEVENLABS_API_KEY=""
